# APFRS Root Environment Configuration
# Copy this file to backend/.env when configuring deployment
# Refer to backend/.env.example for comprehensive field descriptions

NODE_ENV=production
BACKEND_PORT=8001
FRONTEND_URL=https://your-domain.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=apfrs_db
DB_USER=apfrs_app
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

JWT_SECRET=YOUR_MINIMUM_32_CHAR_CRYPTOGRAPHIC_JWT_SECRET
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=YOUR_SECURE_BOOTSTRAP_ADMIN_PASSWORD
