# =================================================================
# APFRS Environment Configuration Template
# For production: copy to backend/.env on your EC2 server and populate
# NEVER commit production secrets or real credentials to Git!
# =================================================================

# Server
NODE_ENV=production
BACKEND_PORT=8001
FRONTEND_URL=https://your-domain.com

# MySQL Database (Local EC2 or RDS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=apfrs_db
DB_USER=apfrs_app
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_POOL_SIZE=15
DB_CONNECT_TIMEOUT=10000
DB_SLOW_QUERY_MS=500

# Authentication & Security (generate with: openssl rand -hex 32)
JWT_SECRET=YOUR_MINIMUM_32_CHAR_CRYPTOGRAPHIC_JWT_SECRET
JWT_EXPIRES_IN=24h
JWT_ISSUER=apfrs
JWT_AUDIENCE=apfrs-api

# Initial Bootstrap Administrator (changed on first login)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=YOUR_SECURE_BOOTSTRAP_ADMIN_PASSWORD
ADMIN_NAME=APFRS Administrator

# Email Service Provider Option A: SMTP (e.g. Amazon SES, Postmark, Google Workspace)
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=notifications@your-domain.com
SMTP_PASSWORD=YOUR_SMTP_CREDENTIAL_PASSWORD

# Email Service Provider Option B: Resend API (Alternative to SMTP)
RESEND_API_KEY=

# Application Worker & Queue Settings
ATTENDANCE_PROCESSING_TIMEOUT_SECONDS=600
ATTENDANCE_MAX_ATTEMPTS=3
RATE_LIMIT_MAX=200
RATE_LIMIT_LOGIN_MAX=10

# Logging
LOG_LEVEL=info
