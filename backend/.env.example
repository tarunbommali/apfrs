# Server Configuration
BACKEND_PORT=8001
NODE_ENV=production
FRONTEND_URL=http://localhost:5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=apfrs_db
DB_POOL_SIZE=10
USE_MYSQL=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
JWT_ISSUER=apfrs
JWT_AUDIENCE=apfrs-api

# SMTP Configuration (for email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=
SMTP_PASSWORD=

# Logging
LOG_LEVEL=info
